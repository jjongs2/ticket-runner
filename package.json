{
  "name": "agent-pipeline",
  "version": "0.5.0",
  "description": "Drives the mattpocock-skills chain unattended: humans plan, the pipeline executes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjongs2/agent-pipeline.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
