{
  "name": "ticket-runner",
  "version": "0.6.1",
  "description": "Drives the mattpocock-skills chain: humans plan, the pipeline executes.",
  "keywords": [
    "claude-code",
    "cli",
    "github-issues",
    "mattpocock-skills"
  ],
  "homepage": "https://jjongs2.github.io/ticket-runner/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjongs2/ticket-runner.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ticket-runner": "./bin/ticket-runner.js"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "!src/testing",
    "docs/templates/operator-skill.md"
  ],
  "scripts": {
    "ticket-runner": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
